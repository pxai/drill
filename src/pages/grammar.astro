---
import Layout from '../layouts/Layout.astro';
import QuizPieChart from '../components/QuizPieChart.astro';

const sections = [
  { icon: '🕐', label: 'Tenses', count: 12, color: 'violet' },
  { icon: '🔗', label: 'Clauses & Conjunctions', count: 8, color: 'sky' },
  { icon: '📌', label: 'Articles & Determiners', count: 6, color: 'emerald' },
  { icon: '🔄', label: 'Modals', count: 9, color: 'amber' },
];
---

<Layout title="Grammar" section="grammar">
  <div class="mb-8">
    <h1 class="text-3xl font-bold text-slate-900 dark:text-white">Grammar</h1>
    <p class="mt-1 text-slate-500 dark:text-slate-400">Coming soon — grammar topics are being added</p>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-10">
    {sections.map((s) => (
      <div class="flex items-center gap-4 p-5 rounded-2xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 opacity-60 cursor-not-allowed select-none">
        <span class="text-3xl">{s.icon}</span>
        <div>
          <div class="flex items-center gap-2">
            <p class="font-semibold text-slate-700 dark:text-slate-200">{s.label}</p>
            <QuizPieChart topicId={s.label.toLowerCase().replace(/\s+/g, '-')} type="gram" />
          </div>
          <p class="text-sm text-slate-400">{s.count} topics</p>
        </div>
        <span class="ml-auto text-xs font-medium bg-slate-100 dark:bg-slate-700 text-slate-400 px-2.5 py-1 rounded-full">Soon</span>
      </div>
    ))}
  </div>

  <div class="rounded-2xl bg-indigo-50 dark:bg-indigo-950 border border-indigo-200 dark:border-indigo-800 p-6 text-center">
    <p class="text-indigo-700 dark:text-indigo-300 font-medium">Grammar section is under construction.</p>
    <p class="text-sm text-indigo-500 dark:text-indigo-400 mt-1">Start with Vocabulary while we get this ready.</p>
    <a href="vocabulary" class="inline-block mt-4 px-5 py-2 rounded-full bg-indigo-600 text-white text-sm font-semibold hover:bg-indigo-500 transition-colors">Go to Vocabulary →</a>
  </div>
</Layout>
