---
interface QuizQuestion {
  id: number;
  question: string;
  options: string[];
  answer: string;
}

interface Props {
  questions: QuizQuestion[];
  topicId: string;
}

const { questions, topicId } = Astro.props;
---

<div id="quiz-container" class="max-w-2xl mx-auto py-4">
  <!-- Progress Header -->
  <div class="mb-8 flex justify-between items-center text-sm font-medium tracking-wide">
    <div class="flex items-center gap-4 text-slate-500">
        <span>Question</span>
        <span id="quiz-counter">1 / {questions.length}</span>
    </div>
    <div id="high-score" class="px-3 py-1 bg-amber-50 dark:bg-amber-900/30 text-amber-700 dark:text-amber-400 rounded-full text-xs font-bold border border-amber-200 dark:border-amber-700/50 hidden">
        Best: 0/0
    </div>
  </div>

  <!-- Quiz Content -->
  <div id="quiz-screen" class="space-y-8">
    <h3 id="question-text" class="text-xl font-bold text-slate-900 dark:text-white leading-snug">
      {questions[0]?.question}
    </h3>

    <div id="options-list" class="grid grid-cols-1 gap-3">
      {questions[0]?.options.map((option, index) => (
        <button
          class="option-btn group w-full text-left p-5 rounded-2xl bg-white dark:bg-slate-800 border-2 border-slate-200 dark:border-slate-700 hover:border-indigo-400 dark:hover:border-indigo-500 hover:bg-indigo-50/50 dark:hover:bg-indigo-950/30 transition-all duration-200"
          data-option={option}
        >
          <div class="flex items-center gap-4">
            <span class="flex-shrink-0 w-8 h-8 rounded-lg bg-slate-100 dark:bg-slate-700 text-slate-500 dark:text-slate-400 text-xs font-black flex items-center justify-center group-hover:bg-indigo-600 group-hover:text-white transition-colors duration-200">
              {String.fromCharCode(65 + index)}
            </span>
            <span class="text-sm font-medium text-slate-700 dark:text-slate-200 group-hover:text-indigo-900 dark:group-hover:text-indigo-300 transition-colors duration-200">
              {option}
            </span>
          </div>
        </button>
      ))}
    </div>
  </div>

  <!-- Results Screen -->
  <div id="results-screen" class="hidden flex-col items-center text-center py-10 space-y-6 animate-in fade-in zoom-in duration-500">
    <div class="w-24 h-24 rounded-full bg-indigo-100 dark:bg-indigo-900 flex items-center justify-center text-indigo-600 dark:text-indigo-300 text-4xl mb-2 mx-auto">
      🏆
    </div>
    <div>
        <h2 class="text-2xl font-bold text-slate-900 dark:text-white">Quiz Completed!</h2>
        <p class="text-slate-500 mt-1">Great job finishing the exercise.</p>
    </div>
    
    <div class="p-8 rounded-3xl bg-slate-100 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-700 w-full max-w-sm">
        <p class="text-xs uppercase tracking-widest text-slate-400 font-bold mb-1">Your Score</p>
        <div class="text-5xl font-black text-indigo-600 dark:text-indigo-400" id="final-score">0 / 0</div>
    </div>

    <div class="flex gap-3 w-full max-w-sm">
        <button id="retry-btn" class="flex-1 py-3 px-6 rounded-2xl bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-700 font-bold hover:bg-slate-50 transition-colors">
            Retry
        </button>
        <button id="back-btn" class="flex-1 py-3 px-6 rounded-2xl bg-indigo-600 text-white font-bold hover:bg-indigo-500 transition-colors">
            Finish
        </button>
    </div>
  </div>
</div>

<script define:vars={{ questions, topicId }}>
  let currentIdx = 0;
  let score = 0;
  
  const quizScreen = document.getElementById('quiz-screen');
  const resultsScreen = document.getElementById('results-screen');
  const questionText = document.getElementById('question-text');
  const optionsList = document.getElementById('options-list');
  const quizCounter = document.getElementById('quiz-counter');
  const finalScoreDiv = document.getElementById('final-score');
  const highScoreBadge = document.getElementById('high-score');
  const retryBtn = document.getElementById('retry-btn');
  const backBtn = document.getElementById('back-btn');

  function saveScore(newScore) {
    const key = `drill_score_voca_${topicId}`;
    const saved = localStorage.getItem(key);
    const best = saved ? parseInt(saved) : 0;
    
    if (newScore > best) {
      localStorage.setItem(key, newScore.toString());
    }
    updateHighScoreDisplay();
  }

  function updateHighScoreDisplay() {
    const key = `drill_score_voca_${topicId}`;
    const saved = localStorage.getItem(key);
    if (saved) {
      highScoreBadge.textContent = `Best: ${saved}/${questions.length}`;
      highScoreBadge.classList.remove('hidden');
    }
  }

  function loadQuestion() {
    const q = questions[currentIdx];
    questionText.textContent = q.question;
    quizCounter.textContent = `${currentIdx + 1} / ${questions.length}`;
    
    optionsList.innerHTML = q.options.map((opt, i) => `
      <button class="option-btn group w-full text-left p-5 rounded-2xl bg-white dark:bg-slate-800 border-2 border-slate-200 dark:border-slate-700 hover:border-indigo-400 dark:hover:border-indigo-500 hover:bg-indigo-50/50 dark:hover:bg-indigo-950/30 transition-all duration-200" data-option="${opt}">
        <div class="flex items-center gap-4">
          <span class="flex-shrink-0 w-8 h-8 rounded-lg bg-slate-100 dark:bg-slate-700 text-slate-500 dark:text-slate-400 text-xs font-black flex items-center justify-center group-hover:bg-indigo-600 group-hover:text-white transition-colors duration-200">
            ${String.fromCharCode(65 + i)}
          </span>
          <span class="text-sm font-medium text-slate-700 dark:text-slate-200 group-hover:text-indigo-900 dark:group-hover:text-indigo-300 transition-colors duration-200">
            ${opt}
          </span>
        </div>
      </button>
    `).join('');

    document.querySelectorAll('.option-btn').forEach(btn => {
      btn.addEventListener('click', handleSelect);
    });
  }

  function handleSelect(e) {
    const selected = e.currentTarget.dataset.option;
    const correct = questions[currentIdx].answer;
    
    // Visual feedback
    const btn = e.currentTarget;
    if (selected === correct) {
      score++;
      btn.classList.add('border-emerald-500', 'bg-emerald-50', 'dark:bg-emerald-950/30');
    } else {
      btn.classList.add('border-rose-500', 'bg-rose-50', 'dark:bg-rose-950/30');
      // Highlight correct one
      document.querySelectorAll(`[data-option="${correct}"]`).forEach(b => {
        b.classList.add('border-emerald-500');
      });
    }

    // Disable all options
    document.querySelectorAll('.option-btn').forEach(b => (b.disabled = true));

    setTimeout(() => {
      if (currentIdx < questions.length - 1) {
        currentIdx++;
        loadQuestion();
      } else {
        showResults();
      }
    }, 1000);
  }

  function showResults() {
    saveScore(score);
    quizScreen.classList.add('hidden');
    resultsScreen.classList.remove('hidden');
    resultsScreen.classList.add('flex');
    finalScoreDiv.textContent = `${score} / ${questions.length}`;
  }

  retryBtn?.addEventListener('click', () => {
    currentIdx = 0;
    score = 0;
    quizScreen.classList.remove('hidden');
    resultsScreen.classList.add('hidden');
    resultsScreen.classList.remove('flex');
    loadQuestion();
  });

  backBtn?.addEventListener('click', () => {
    window.location.href = window.location.pathname.replace(/\/\d+$/, '');
  });

  // Initial
  loadQuestion();
  updateHighScoreDisplay();
</script>
