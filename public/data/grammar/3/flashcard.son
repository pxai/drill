[
  {
    "id": 1,
    "front": "Past Simple vs. Present Perfect (Finished time)",
    "back": "Use the Past Simple for finished time periods (e.g., 'I overslept this morning') and Present Perfect for periods continuing until now (e.g., 'I have read three lectures today')."
  },
  {
    "id": 2,
    "front": "Present Perfect with 'since'",
    "back": "Used for a situation that started in the past and still exists (e.g., 'Maria has been able to go swimming since she fell in the river')."
  },
  {
    "id": 3,
    "front": "News reporting",
    "back": "The Present Perfect is often used to give news, while the Past Simple provides details (e.g., 'Inflation has dropped... It is the first time in two years...')."
  },
  {
    "id": 4,
    "front": "Present Perfect with 'yet'",
    "back": "Used to talk about things expected to happen up to the present (e.g., 'I haven't read much of the report yet')."
  },
  {
    "id": 5,
    "front": "'Since' + Past Simple clause",
    "back": "The word 'since' is followed by a specific point in time or a clause in the past simple (e.g., 'since she started at school')."
  },
  {
    "id": 6,
    "front": "Past Simple (Specific duration)",
    "back": "Used for actions that happened at a definite time in the past (e.g., 'It was so hot today that I wore shorts')."
  },
  {
    "id": 7,
    "front": "Present Perfect (Life experience)",
    "back": "Used to talk about things that have happened at some point in your life up to now (e.g., 'A lot has happened since I last spoke to you')."
  },
  {
    "id": 8,
    "front": "Sequence of events",
    "back": "The Past Simple is used to describe a sequence of completed past events."
  },
  {
    "id": 9,
    "front": "Present Perfect (State duration)",
    "back": "Shows a state that continues to the present (e.g., 'Stefan's reading has improved enormously since...')."
  },
  {
    "id": 10,
    "front": "Past Simple (Details of a report)",
    "back": "Used to give specifics about a news event (e.g., 'Three elderly patients died last week')."
  },
  {
    "id": 11,
    "front": "'Already' with Present Perfect",
    "back": "Indicates that something happened sooner than expected (e.g., 'I have already read three lectures')."
  },
  {
    "id": 12,
    "front": "Past Simple (Mental recognition)",
    "back": "Used for moments of recognition or decision in the past (e.g., 'I recognised her the moment I heard her laugh')."
  },
  {
    "id": 13,
    "front": "Present Perfect (Result in present)",
    "back": "Used when the result of a past action is relevant now (e.g., 'We have spent £200 on food this month')."
  },
  {
    "id": 14,
    "front": "Past Simple (Point in history)",
    "back": "Used for events viewed as a specific point in history (e.g., 'Remember that after you signed the contract...')."
  },
  {
    "id": 15,
    "front": "'Lately/Recently' context",
    "back": "These often trigger the Present Perfect to describe recent occurrences (e.g., 'A lot has happened recently')."
  }
]